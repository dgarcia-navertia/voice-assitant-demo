# =============================================================================
# Navertia Voice Demo - unico .env en la raiz, lo leen calendar y bot.
# Copia a .env (gitignored) y rellena. Nunca commitees secretos.
# =============================================================================

# --- Puertos publicados al host (solo dev) -----------------------------------
PHP_PORT=8090
PHPMYADMIN_PORT=8091
BOT_PORT=7860
DB_PORT=3316

# --- Base de datos (MariaDB) --------------------------------------------------
DB_HOST=db
DB_DATABASE=navertia
DB_USER=navertia
DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root

# --- App PHP -------------------------------------------------------------------
APP_ENV=dev
APP_URL=http://localhost:8090
# Contrasena de los usuarios sembrados (solo dev; ver docs/CREDENTIALS.md)
SEED_USER_PASSWORD=Navertia-Dev-2026!

# --- Autenticacion entre servicios --------------------------------------------
# Secreto compartido en las dos direcciones: el bot lo manda a la API interna
# de PHP (/mcp/*) y PHP lo manda al POST /dial-out del bot.
# Generalo con: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me

# --- Direcciones internas (red de Docker) -------------------------------------
PHP_API_BASE_URL=http://php
BOT_BASE_URL=http://bot:7860

# --- Twilio ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero de Twilio desde el que se llama (E.164)
TWILIO_PHONE_NUMBER=
# URL publica (https) del bot, alcanzable por Twilio. En local: `make tunnel`.
PUBLIC_BASE_URL=https://voice.example.com
# Numero al que se transfiere la llamada en commercial_handoff (E.164)
HANDOFF_PHONE_NUMBER=
# Validar la firma X-Twilio-Signature en los webhooks (dejar en true)
TWILIO_VALIDATE_SIGNATURE=true

# --- LLM ------------------------------------------------------------------------
# google | anthropic | openrouter | openai
LLM_PROVIDER=google
LLM_MODEL_ID=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.3
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- STT (Deepgram) -------------------------------------------------------------
DEEPGRAM_API_KEY=
STT_MODEL_ID=nova-3-general
STT_LANGUAGE=es

# --- TTS (ElevenLabs) -----------------------------------------------------------
ELEVEN_LABS_API_KEY=
TTS_MODEL_ID=eleven_flash_v2_5
TTS_VOICE_ID=dNjJKg63Fr5AXwIdkATa
TTS_LANGUAGE=es

# --- Conversacion -----------------------------------------------------------------
GREETING=Soy el asistente virtual de Navertia. ¿En qué te puedo ayudar?
# Silencio del usuario antes de preguntar "¿sigues ahi?" y reintentos maximos
IDLE_TIMEOUT_SECS=20
IDLE_MAX_RETRIES=2
LOG_LEVEL=INFO

# --- Produccion (docker-compose.prod.yml + Caddy) -------------------------------
# Dominio unico: sirve la app PHP en / y el bot en /ws, /twilio/*, /webrtc, etc.
APP_DOMAIN=navertia.example.com
ACME_EMAIL=ops@example.com
